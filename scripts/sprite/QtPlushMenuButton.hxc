package rewired.sprite;

import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.freeplay.FreeplayState;
import funkin.modding.module.Module;
import funkin.audio.FunkinSound;
import funkin.util.HapticUtil;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.util.TouchUtil;
import funkin.input.Cursor;
import funkin.input.CursorMode;
import flixel.effects.FlxFlicker;
import funkin.util.WindowUtil;
import flixel.FlxSprite;
import funkin.save.Save;
import flixel.util.FlxTimer;
import Date;

class QtPlushMenuButton extends Module
{
  var idleScale:Float = 0.5;
  var idleOffsetX:Float = 50;
  var idleOffsetY:Float = 80;
  var selectScale:Float = 0.75;
  var selectOffsetX:Float = 40;
  var selectOffsetY:Float = 110;
  var plushButton:FunkinSprite;
  var gradient:FunkinSprite;
  var qtHitbox:FlxSprite;
  var bubbleHitbox:FlxSprite;
  var isHovering:Bool = false;
  var plushFocused:Bool = false;
  var offsetTween:FlxTween;
  var busy:Bool = false;
  var lastSelectedIndex:Int = 0;
  var initialized:Bool = false;
  var currentOffsetX:Float = 0;
  var currentOffsetY:Float = 0;

  public function new()
  {
    super('QtPlushMenuButton', 1, {
      state: MainMenuState
    });
  }

  function onUpdate(event)
  {
    super.onUpdate(event);

    if (!shouldPlush) return;
    if (isExpired) return;
    if (plushButton == null) return;

    var stateDyn:MainMenuState = FlxG.state;

    if (!plushButton.alive || !plushButton.exists)
    {
      plushButton.kill();
      plushButton.destroy();
      plushButton = null;
      initialized = false;
      initButton();
    }

    if (FlxG.state.subState is FreeplayState) return;

    var controls = stateDyn.controls;
    var menuItems = stateDyn.menuItems;

    #if mobile
      var backBtn = stateDyn.backButton;
      var optionsBtn = stateDyn.optionsButton;

      if (backBtn != null)
      {
        backBtn.enabled = !busy;
        backBtn.active = !busy;
      }
      if (optionsBtn != null)
      {
        var shouldDisable = plushFocused || isHovering || busy;
        optionsBtn.enabled = !shouldDisable;
        optionsBtn.active = !shouldDisable;
      }
    #end

    if (busy)
    {
      if (menuItems != null)
      {
        menuItems.enabled = false;
        menuItems.busy = true;
      }
      return;
    }

    if (controls.UI_LEFT_P && plushFocused)
    {
      plushFocused = false;
      isHovering = false;
      if (menuItems != null)
      {
        menuItems.enabled = true;
        menuItems.selectItem(lastSelectedIndex);
      }
      setPlushIdle();
      FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.4);
    }
    else if (controls.UI_RIGHT_P && !plushFocused)
    {
      plushFocused = true;
      isHovering = false;
      if (menuItems != null)
      {
        lastSelectedIndex = menuItems.selectedIndex;
        var selectedItem = menuItems.selectedItem;
        if (selectedItem != null) selectedItem.idle();
        menuItems.enabled = false;
      }
      setPlushSelect();
      FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.4);
    }

    if (plushFocused && controls.ACCEPT_P)
    {
      onPlushClick();
    }

    var isOverlapping = false;
    #if mobile
      if (TouchUtil.pressed)
      {
        isOverlapping = TouchUtil.overlaps(qtHitbox) || TouchUtil.overlaps(bubbleHitbox);
        if (isOverlapping && TouchUtil.justPressed)
        {
          onPlushClick();
        }
      }
    #else
      if (plushButton.exists) isOverlapping = FlxG.mouse.overlaps(qtHitbox) || FlxG.mouse.overlaps(bubbleHitbox);
      else
        initButton();

      if (isOverlapping && FlxG.mouse.justPressed)
      {
        onPlushClick();
      }
     #end

    #if !mobile
    Cursor.cursorMode = isHovering ? CursorMode.Pointer:CursorMode.Default;
    #end

    if (isOverlapping && !isHovering)
    {
      isHovering = true;
      var wasKeyboardFocused = plushFocused;
      if (plushFocused) plushFocused = false;

      if (menuItems != null)
      {
        lastSelectedIndex = menuItems.selectedIndex;
        var selectedItem = menuItems.selectedItem;
        if (selectedItem != null) selectedItem.idle();
        menuItems.enabled = false;
      }

      if (!wasKeyboardFocused) FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.4);
      setPlushSelect();
    }
    else if (!isOverlapping && isHovering && !plushFocused)
    {
      isHovering = false;
      if (menuItems != null)
      {
        menuItems.enabled = true;
        menuItems.selectItem(lastSelectedIndex);
      }
      FunkinSound.playOnce(Paths.sound('scrollMenu-reversed'), 0.4);
      setPlushIdle();
    }
  }

  override public function onStateChangeBegin(event)
  {
    super.onStateChangeBegin(event);
    #if !mobile
    Cursor.hide();
    #end
    initialized = false;
  }

  public function onStateChangeEnd(event)
  {
    super.onStateChangeEnd(event);
    if(isExpired) return;
    if (plushButton == null)
    {
      initialized = false;
      initButton();
    }
    if (!initialized) initButton();

    busy = false;
    plushFocused = false;
    isHovering = false;
    lastSelectedIndex = 0;

    FlxTween.cancelTweensOf(plushButton.scale);
    FlxTween.cancelTweensOf(qtHitbox.scale);
    FlxTween.cancelTweensOf(bubbleHitbox.scale);
    FlxTween.cancelTweensOf(gradient);

    offsetTween?.cancel();

    #if mobile
      var stateDyn:Dynamic = FlxG.state;
      var backBtn = stateDyn.backButton;
      if (backBtn != null)
      {
        backBtn.x = FlxG.width - 230;
        backBtn.y = 50;
      }
    #end
  }

  override public function onSubStateOpenBegin(event)
  {
    super.onSubStateOpenBegin(event);
    #if !mobile
    Cursor.hide();
    #end
  }

  override public function onFreeplayIntroDone(event)
  {
    super.onFreeplayIntroDone(event);
    #if !mobile
    Cursor.hide();
    #end
  }

  override public function onSubStateCloseEnd(event)
  {
    super.onSubStateCloseEnd(event);
    if (isExpired) return;
    #if !mobile
    Cursor.show();
    #end
  }

  static var shouldPlush(get, never):Bool;

  static function get_shouldPlush():Bool
  {
    var result:Bool = true;

    if (Save.instance.modOptions.exists("com.rewired.plush-show-plush-advert"))
    {
      result = Save.instance.modOptions.get("com.rewired.plush-show-plush-advert");
    }

    return result;
  }


  static var isExpired(get, never):Bool;

  static function get_isExpired():Bool
  {
    var date = Date.now();
    var currentDate:String = '${date.getUTCFullYear()}-${(date.getUTCMonth() + 1 < 10 ? '0' : "") + (date.getUTCMonth() + 1)}-${(date.getUTCDate() < 10 ? '0' : "") + date.getUTCDate()}';
    var expirationDate:String = "2026-08-04";
    if(currentDate == expirationDate) return date.getUTCHours() >= 19;
    return currentDate > expirationDate;
  }

  function initButton()
  {
    if (!shouldPlush) return;
    if (isExpired) return;

    if (!initialized) initialized = true;
    else
      return;

    gradient = new FunkinSprite();
    gradient.loadGraphic(Paths.image('gradient'));
    gradient.screenCenter();
    gradient.updateHitbox();
    gradient.scale.set(FlxG.width / 1280, FlxG.height / 720);
    gradient.scrollFactor.set(0, 0);
    gradient.alpha = 0;
    FlxG.state.add(gradient);

    plushButton = new FunkinSprite().loadTextureAtlas("mainmenu/plushButton");
    plushButton.anim.play("idle");
    plushButton.anim.curAnim.looped = true;
    plushButton.scale.set(idleScale * 2, idleScale * 2);

    currentOffsetX = idleOffsetX;
    currentOffsetY = idleOffsetY;

    qtHitbox = new FlxSprite(plushButton.x, plushButton.y).makeGraphic(plushButton.width * 1.2, plushButton.height * 1.38);    
    bubbleHitbox = new FlxSprite(plushButton.x, plushButton.y).makeGraphic(plushButton.width * 1.15, plushButton.height * 0.85);

    qtHitbox.scale.set(idleScale, idleScale);
    bubbleHitbox.scale.set(idleScale, idleScale);

    qtHitbox.visible = false;
    bubbleHitbox.visible = false;

    updatePlushPosition();
    plushButton.scrollFactor.set();
    qtHitbox.scrollFactor.set();
    bubbleHitbox.scrollFactor.set();

    plushButton.revive();
    FlxG.state.add(plushButton);
    FlxG.state.add(qtHitbox);
    FlxG.state.add(bubbleHitbox);
    #if !mobile 
    Cursor.show();
    #end
  }

  function updatePlushPosition()
  {
    var baseMargin:Float = 20;

    for(sprite in [plushButton, qtHitbox, bubbleHitbox])
    {
      sprite?.updateHitbox();
      var baseX:Float = FlxG.width - sprite?.width - baseMargin;
      var baseY:Float = FlxG.height - sprite?.height - baseMargin;

      sprite?.setPosition(baseX + currentOffsetX, baseY + currentOffsetY)
      if(sprite == qtHitbox)
      {
        sprite.y -= 30;
        sprite.x -= 30;
      }
      else if(sprite == bubbleHitbox)
      {
        sprite.y -= 250;
        sprite.x -= 170;
      }
    }
  }

  function setPlushSelect()
  {
    var syncFrame:Int = 0;
    if (plushButton.animation.curAnim != null)
    {
      syncFrame = plushButton.anim.curAnim.curFrame;
    }
    plushButton.anim.play("select", true, false, syncFrame);
    plushButton.anim.curAnim.looped = true;
    updatePlushPosition();

    var startX = currentOffsetX;
    var startY = currentOffsetY;

    offsetTween?.cancel();
    offsetTween = FlxTween.num(0, 1, 0.3, {
      ease: FlxEase.cubeOut
    }, function(v:Float)
    {
      currentOffsetX = startX + (selectOffsetX - startX) * v;
      currentOffsetY = startY + (selectOffsetY - startY) * v;
    });

    FlxTween.cancelTweensOf(qtHitbox.scale);
    FlxTween.tween(qtHitbox.scale, {
      x: selectScale,
      y: selectScale
    }, 0.3, {
      ease: FlxEase.cubeOut
    });

    FlxTween.cancelTweensOf(bubbleHitbox.scale);
    FlxTween.tween(bubbleHitbox.scale, {
      x: selectScale * 1.15,
      y: selectScale * 1.5
    }, 0.3, {
      ease: FlxEase.cubeOut
    });

    FlxTween.cancelTweensOf(plushButton.scale);
    FlxTween.tween(plushButton.scale, {
      x: selectScale * 2,
      y: selectScale * 2
    }, 0.3, {
      ease: FlxEase.cubeOut,
      onUpdate: function(tween)
      {
        updatePlushPosition();
      }
    });

    FlxTween.cancelTweensOf(gradient);
    FlxTween.tween(gradient, {
      alpha: 1
    }, 0.45, {
      ease: FlxEase.cubeOut
    });

    #if mobile HapticUtil.vibrate(0, 0.01, 0.5); #end
  }

  function setPlushIdle()
  {
    var syncFrame:Int = 0;
    if (plushButton.animation.curAnim != null)
    {
      syncFrame = plushButton.animation.curAnim.curFrame;
    }
    plushButton.animation.play("idle", true, false, syncFrame);

    updatePlushPosition();

    var startX = currentOffsetX;
    var startY = currentOffsetY;

    offsetTween?.cancel();
    offsetTween = FlxTween.num(0, 1, 0.6, {
      ease: FlxEase.cubeOut
    }, function(v:Float)
    {
      currentOffsetX = startX + (idleOffsetX - startX) * v;
      currentOffsetY = startY + (idleOffsetY - startY) * v;
    });


    FlxTween.cancelTweensOf(qtHitbox.scale);
    FlxTween.tween(qtHitbox.scale, {
      x: idleScale,
      y: idleScale
    }, 0.3, {
      ease: FlxEase.cubeOut
    });

    FlxTween.cancelTweensOf(bubbleHitbox.scale);
    FlxTween.tween(bubbleHitbox.scale, {
      x: idleScale,
      y: idleScale
    }, 0.3, {
      ease: FlxEase.cubeOut
    });

    FlxTween.cancelTweensOf(plushButton.scale);
    FlxTween.tween(plushButton.scale, {
      x: idleScale * 2,
      y: idleScale * 2
    }, 0.3, {
      ease: FlxEase.cubeOut,
      onUpdate: function(tween)
      {
        updatePlushPosition();
      }
    });

    FlxTween.cancelTweensOf(gradient);
    FlxTween.tween(gradient, {
      alpha: 0
    }, 0.45, {
      ease: FlxEase.cubeOut
    });
  }

  function onPlushClick()
  {
    if (busy) return;
    #if !mobile
    Cursor.cursorMode = CursorMode.Grabbing;
    #end
    busy = true;

    var stateDyn:Dynamic = FlxG.state;
    var menuItems = stateDyn.menuItems;
    if (menuItems != null)
    {
      menuItems.enabled = false;
      menuItems.busy = true;
    }

    FunkinSound.playOnce(Paths.sound('confirmMenu'));
    #if mobile HapticUtil.vibrate(0, 0.05, 1); #end

    if (Preferences.flashingLights)
    {
      FlxFlicker.flicker(plushButton, 1, 0.06, true, false, function(_)
      {
        #if !mobile
        if(isHovering) Cursor.cursorMode = CursorMode.Pointer;
        #end
        busy = false;
        WindowUtil.openURL("https://www.makeship.com/products/qt-plushie");
      });
    }
    else
    {
      #if !mobile
      new FlxTimer().start(0.2, t -> if(isHovering) Cursor.cursorMode = CursorMode.Pointer);
      #end
      busy = false;
      WindowUtil.openURL("https://www.makeship.com/products/qt-plushie");
    }
  }
}
