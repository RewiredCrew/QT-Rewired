package rewired.modules.playstate.dodgemechanic;

import flixel.input.keyboard.FlxKey;
import flixel.input.keyboard.FlxKeyInput;
import funkin.Conductor;
import funkin.input.PreciseInputManager;
//import funkin.input.PreciseInputEvent; //typedef....
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.SongLoadScriptEvent;
import funkin.modding.events.SongRetryEvent;
import funkin.modding.events.StateChangeScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.play.notes.NoteDirection;

/**
 * This module is the core point of Sawblade dodge mechanic.
 */
class SawbladeMechanicModule extends Module
{
  /*public static function query() {  
  }*/
  public static var instance:SawbladeMechanicModule = null;

  /**
   * Defines Sawblade Dodge Mechanic event id to determine if we should use it in song or not.
   */
  private static var mechanicEventName:String = "sawKB";

  //temp
  public var dodgeKey:FlxKey = FlxKey.SPACE;

  public var currentGame(get, never):PlayState;

  function get_currentGame():PlayState
  {
    return PlayState.instance;
  }

  public var moduleActive:Bool = false;

  private var preciseInputsRegistered:Bool = false;
  private var dodgeKeyRegistered:Bool = false;
  private var dodgeKeyInput:Null<FlxKeyInput> = null;

  var inputPressQueue:Array<PreciseInputEvent> = [];
  var inputReleaseQueue:Array<PreciseInputEvent> = [];

  public function new()
  {
    super("qt-rewired_SawbladeMechanicModule", 0, {
      state: PlayState
    });

    instance = this;
  }

  override function onSongLoaded(event:SongLoadScriptEvent):Void
  {
    super.onSongLoaded(event);

    if (currentGame == null || currentGame.currentChart == null || currentGame.isMinimalMode) return;

    for (ev in currentGame.currentChart.events)
    {
      if (ev.eventKind == mechanicEventName)
      {
        moduleActive = true;
        break;
      }
    }
  }

  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    // Doing this here becase onSongLoaded BEFORE PreciseInputManager loaded PlayState's on key press/release functions >:(
    if (moduleActive)
    {
      registerDodgeKey();
      initPreciseInputs();
    }
  }

  function registerDodgeKey():Void
  {
    if (dodgeKeyRegistered) return;

    var manager = PreciseInputManager.instance;

    // Do not steal a key which is already assigned to one of the note lanes. nuh UH!!!
    if (manager.getInputByKey(dodgeKey) != null)
    {
      trace('[QT:REWIRED] Cannot register dodge key ${dodgeKey}: it is already bound to a note.');
      return;
    }

    var input = new FlxKeyInput(dodgeKey);

    // oh my sweet polymod STRYCT_SYNTAX
    //@:privateAccess
    //{
      if (manager._keyList.indexOf(dodgeKey) == -1)
        manager._keyList.push(dodgeKey);

      manager._keyListArray.push(input);
      manager._keyListMap.set(dodgeKey, input);

      manager._keyListDir.set(dodgeKey, NoteDirection.LEFT);
    //}

    dodgeKeyInput = input;
    dodgeKeyRegistered = true;

    trace('[QT:REWIRED] Registered sawblade dodge key: ${dodgeKey}');
  }

  private function unregisterDodgeKey():Void
  {
    if (!dodgeKeyRegistered) return;

    var manager = PreciseInputManager.instance;
    var registeredInput:Null<FlxKeyInput> = null;

    // oh my sweet polymod STRYCT_SYNTAX AGAIN
    //@:privateAccess
    //{
      registeredInput = manager._keyListMap.get(dodgeKey);

      if (registeredInput == dodgeKeyInput)
      {
        manager._keyList.remove(dodgeKey);
        if (dodgeKeyInput != null)
          manager._keyListArray.remove(dodgeKeyInput);
        manager._keyListMap.remove(dodgeKey);
        manager._keyListDir.remove(dodgeKey);
      }
      else if (registeredInput == null)
      {
        manager._keyList.remove(dodgeKey);
        if (dodgeKeyInput != null)
          manager._keyListArray.remove(dodgeKeyInput);
      }
    //}

    if (dodgeKeyInput != null)
      dodgeKeyInput.release();

    dodgeKeyInput = null;
    dodgeKeyRegistered = false;
  }

  private function initPreciseInputs():Void
  {
    if (preciseInputsRegistered) return;

    var manager = PreciseInputManager.instance;
    manager.onInputPressed.add(onKeyPress);
    manager.onInputReleased.add(onKeyRelease);

    preciseInputsRegistered = true;
  }

  private function isDodgeKeyEvent(event:PreciseInputEvent):Bool
  {
    if (!dodgeKeyRegistered) return false;

    var eventKey:FlxKey;

    @:privateAccess
    eventKey = PreciseInputManager.convertKeyCode(event.keyCode);

    return eventKey == dodgeKey;
  }

  private function onKeyPress(event:PreciseInputEvent):Void
  {
    if (currentGame == null || currentGame.isGamePaused) return;

    if (isDodgeKeyEvent(event))
    {
      // remove key event from main keyshit :troll:
      currentGame.inputPressQueue.remove(event);
      
      inputPressQueue.push(event);
      event.position = Conductor.instance.songPosition;
      //trace('DODGE PRESSED at ${event.position} ms');
    }
  }

  private function onKeyRelease(event:PreciseInputEvent):Void
  {
    if (currentGame == null || currentGame.isGamePaused) return;

    if (isDodgeKeyEvent(event))
    {
      // remove key event from main keyshit :troll:
      currentGame.inputReleaseQueue.remove(event);

      inputReleaseQueue.push(event);
      event.position = Conductor.instance.songPosition;
      //trace(' DODGE RELEASED at ${event.position} ms');
    }
  }

  override function onUpdate(event):Void
  {
    if (moduleActive)
      processInputQueue();
    //else if (currentGame.isBotPlayMode) botplaysawbaldeshit
  }

  public var isDodgingInput:Bool = false;

  //TODO: add BOTPLAY
  function processInputQueue():Void
  {
    if (inputPressQueue.length + inputReleaseQueue.length == 0) return;

    // Ignore inputs during cutscenes.
    if (currentGame.isInCutscene || currentGame.disableKeys)
    {
      inputPressQueue = [];
      inputReleaseQueue = [];
      return;
    }

    while (inputPressQueue.length > 0)
    {
      var input:Null<PreciseInputEvent> = inputPressQueue.shift();
      if (input == null) continue;

      //FlxG.camera.angle += 5;
      
      isDodgingInput = true;

      //TODO: do check if any sawblade event is in progress lmao
      //var inputPosition:Float = input.position ?? 0.0;
      //var inputLatencyNs:Int64 = PreciseInputManager.getCurrentTimestamp() - input.timestamp;
      //var inputLatencyMs:Float = inputLatencyNs.toFloat() / Constants.NS_PER_MS;
      //var noteDiff:Int = Std.int(inputPosition - note.noteData.time - inputLatencyMs);
      //trace(inputLatencyMs);
    }

    while (inputReleaseQueue.length > 0)
    {
      var input:Null<PreciseInputEvent> = inputReleaseQueue.shift();
      if (input == null || !isDodgingInput) continue;

      //FlxG.camera.scrollAngle += 15;

      isDodgingInput = false;
    }
  }

  override function onStateChangeBegin(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeBegin(event);
    reset();
  }

  override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    reset();
  }

  override function onGameOver(event:ScriptEvent):Void
  {
    super.onGameOver(event);
    reset();
  }

  override function onSongRetry(event:SongRetryEvent):Void
  {
    super.onSongRetry(event);
    reset();
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    reset();
  }

  public function reset():Void
  {
    moduleActive = false;

    if (preciseInputsRegistered)
    {
      var manager = PreciseInputManager.instance;
      manager.onInputPressed.remove(onKeyPress);
      manager.onInputReleased.remove(onKeyRelease);
      preciseInputsRegistered = false;
    }

    unregisterDodgeKey();

    inputPressQueue = [];
    inputReleaseQueue = [];

    trace('Resetting sawblade module...');
  }
}