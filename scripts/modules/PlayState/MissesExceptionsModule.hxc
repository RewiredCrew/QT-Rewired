  override function onSongLoaded(event)
  {
    super.onSongLoaded(event);

    _ignoreExclusionPref = getPlayer().ignoreExclusionPref;
  }

  override function onNoteGhostMiss(event)
  {
    super.onNoteGhostMiss(event);
    if (_ignoreExclusionPref == null) return;
    var player = getPlayer();
    if (player != null && _ignoreExclusionPref.indexOf(player.getCurrentAnimation()) != -1)
    {
      event.cancel();
      event.stopPropagation();
    }
  }

  function getPlayer()
  {
    return PlayState.instance.currentStage != null ? PlayState.instance.currentStage.getBoyfriend() : null;
  }
}
