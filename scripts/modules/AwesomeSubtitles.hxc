package rewired.modules;

import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.Conductor;
import funkin.Assets;
import funkin.Paths;
import funkin.Preferences;
import funkin.util.Constants;
import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.text.FlxTextFormat;
import funkin.util.FlxTweenUtil;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxColor;
import flixel.math.FlxRect;
import StringTools;

class AwesomeSubtitles extends Module
{
  static final LYRICS_FILE_KEY:String = 'song-lyrics-awesome';

  static final MARGIN_LEFT:Float = 12;
  static final MARGIN_BOTTOM:Float = 221;

  static final TOP_TEXT_SCALE:Float = 0.914;
  static final BOTTOM_TEXT_SCALE:Float = 0.777;
  static final LINE_DISTANCE:Float = 24;

  static final MOBILE_SCALE:Float = 1.22;

  static final FONT_SIZE:Int = 28;
  static final FONT_NAME:String = 'vcr.ttf';
  static final OUTLINE_COLOR:Int = 0xFF000000;
  static final OUTLINE_SIZE:Float = 1.75;

  static final FORMAT_TAGS:Array<String> = ['b', 'strong', 'i', 'em', 'u', 's', 'font'];

  static final NEXT_ALPHA:Float = 0.3;
  static final NEXT_LINE_LEAD_MS:Float = 5000.67;
  static final PHRASE_GAP_MS:Float = 3000;
  static final PHRASE_START_LEAD_MS:Float = 1500;

  static final PROMOTE_TIME:Float = 0.2;
  static final FADE_IN_TIME:Float = 0.2;
  static final FADE_OUT_TIME:Float = 0.25;
  static final ENTER_SLIDE_Y:Float = 10;

  var pool:Array<FlxText> = [];
  var highlightPool:Array<FlxText> = [];

  var topText:FlxText;
  var bottomText:FlxText;
  var topHighlight:FlxText;
  var bottomHighlight:FlxText;

  var owner:PlayState;
  var entries:Array<Dynamic> = [];
  var cursor:Int = 0;
  var shownCur:Int = -1;
  var shownNext:Int = -1;

  public function new()
  {
    super('AwesomeSubtitles', 1000);
  }

  public override function onSongLoaded(event:SongLoadScriptEvent):Void
  {
    setupForCurrentSong();
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    setupForCurrentSong();
  }

  public override function onSongRetry(event:SongRetryEvent):Void
  {
    resetDisplay();
  }

  public override function onGameOver(event:ScriptEvent):Void
  {
    releaseState();
  }

  public override function onDestroy(event:ScriptEvent):Void
  {
    releaseState();
  }

  public override function onPause(event:PauseScriptEvent):Void
  {
    super.onPause(event);

    for (text in pool)
    {
      FlxTweenUtil.pauseTweensOf(text);
      FlxTweenUtil.pauseTweensOf(text.scale);
    }

    for (text in highlightPool)
    {
      FlxTweenUtil.pauseTweensOf(text);
      FlxTweenUtil.pauseTweensOf(text.scale);
    }
  }

  public override function onResume(event:ScriptEvent):Void
  {
    super.onResume(event);

    for (text in pool)
    {
      FlxTweenUtil.resumeTweensOf(text);
      FlxTweenUtil.resumeTweensOf(text.scale);
    }

    for (text in highlightPool)
    {
      FlxTweenUtil.resumeTweensOf(text);
      FlxTweenUtil.resumeTweensOf(text.scale);
    }
  }

  public override function onUpdate(event:UpdateScriptEvent):Void
  {
    if (pool.length == 0) return;

    if (PlayState.instance != owner)
    {
      releaseState();
      return;
    }

    var songPosition:Float = Conductor.instance.songPosition;
    while (cursor < entries.length && entries[cursor].start <= songPosition)
      cursor++;
    while (cursor > 0 && entries[cursor - 1].start > songPosition)
      cursor--;

    var currentIdx:Int = (cursor > 0 && songPosition < entries[cursor - 1].end) ? cursor - 1 : -1;
    var nextIdx:Int = (cursor < entries.length && canPreview(cursor, songPosition)) ? cursor : -1;
    syncLines(currentIdx, nextIdx);

    updateHighlight(topText, songPosition);
    updateHighlight(bottomText, songPosition);

    for (poolArr in [pool, highlightPool])
      for (text in poolArr)
        text.offset.set(text.origin.x * (1 - text.scale.x), text.origin.y * (1 - text.scale.y));
  }

  function setupForCurrentSong():Void
  {
    var state:PlayState = PlayState.instance;
    if (state == null) return;

    var variation:String = state.currentVariation;
    var suffix:String = (variation == null || variation == Constants.DEFAULT_VARIATION) ? '' : '-' + variation;

    if (!Preferences.subtitles)
    {
      releaseState();
      return;
    }

    if (owner != state)
    {
      releaseState();
      entries = loadEntries(state.currentSong.id, suffix);
      if (entries.length == 0) return;

      owner = state;
      buildTextPool(state);
    }

    resetDisplay();
  }

  function buildTextPool(state:PlayState):Void
  {
    for (i in 0...6)
    {
      var text:FlxText = makeText(state, FlxColor.GRAY);
      var highlight:FlxText = makeText(state, FlxColor.WHITE);

      state.add(text);
      state.add(highlight);

      pool.push(text);
      highlightPool.push(highlight);
    }
  }

  function makeText(state:PlayState, color:FlxColor):FlxText
  {
    var text:FlxText = new FlxText(0, 0, 0, '');

    text.setFormat(
      Paths.font(FONT_NAME),
      FONT_SIZE,
      color,
      'left',
      FlxTextBorderStyle.OUTLINE,
      OUTLINE_COLOR
    );

    text.borderSize = OUTLINE_SIZE;
    text.antialiasing = true;
    text.scrollFactor.set();
    text.moves = false;
    text.visible = false;
    text.cameras = [state.camSubtitles];

    return text;
  }

  function releaseState():Void
  {
    for (text in pool)
    {
      if (!text.exists) continue;

      cancelTweens(text);
      owner.remove(text, true);
      text.destroy();
    }

    for (text in highlightPool)
    {
      if (!text.exists) continue;

      cancelTweens(text);
      owner.remove(text, true);
      text.destroy();
    }

    pool = [];
    highlightPool = [];

    topText = null;
    bottomText = null;
    topHighlight = null;
    bottomHighlight = null;

    owner = null;
    entries = [];
  }

  function resetDisplay():Void
  {
    for (text in pool)
    {
      cancelTweens(text);
      text.visible = false;
      text.clipRect = null;
    }

    for (text in highlightPool)
    {
      cancelTweens(text);
      text.visible = false;
      text.clipRect = null;
    }

    topText = null;
    bottomText = null;
    topHighlight = null;
    bottomHighlight = null;

    cursor = 0;
    shownCur = -1;
    shownNext = -1;
  }

  function syncLines(currentIdx:Int, nextIdx:Int):Void
  {
    if (currentIdx != shownCur)
    {
      var outgoing:FlxText = topText;

      if (currentIdx != -1 && currentIdx == shownNext)
      {
        topText = bottomText;
        topHighlight = bottomHighlight;

        bottomText = null;
        bottomHighlight = null;

        shownNext = -1;

        promoteToTop(topText);
        promoteToTop(topHighlight);
      }
      else
      {
        topText = (currentIdx == -1) ? null : acquireText();
        topHighlight = getHighlight(topText);

        if (topText != null)
          showLine(topText, entries[currentIdx], true, 1);
      }

      fadeOut(outgoing);
      shownCur = currentIdx;
    }

    if (nextIdx != shownNext)
    {
      fadeOut(bottomText);

      bottomText = (nextIdx == -1) ? null : acquireText();
      bottomHighlight = getHighlight(bottomText);

      if (bottomText != null)
        showLine(bottomText, entries[nextIdx], false, NEXT_ALPHA);

      shownNext = nextIdx;
    }
  }

  function showLine(text:FlxText, entry:Dynamic, isTop:Bool, targetAlpha:Float):Void
  {
    var highlight:FlxText = getHighlight(text);
    if (highlight == null) return;

    var lineScale:Float = (isTop ? TOP_TEXT_SCALE : BOTTOM_TEXT_SCALE) * mobileScale();
    var targetY:Float = slotY(isTop);

    text.italic = false;
    text.bold = false;
    text.color = FlxColor.GRAY;
    text.font = (entry.font != null) ? entry.font : Paths.font(FONT_NAME);
    text.clearFormats();
    text.text = entry.text;

    highlight.italic = false;
    highlight.bold = false;
    highlight.color = FlxColor.WHITE;
    highlight.font = text.font;
    highlight.clearFormats();
    highlight.text = entry.text;

    for (run in entry.runs)
    {
      var formatGray:FlxTextFormat = new FlxTextFormat(FlxColor.multiply(run.color, FlxColor.GRAY), run.bold, run.italic, OUTLINE_COLOR);
      var formatWhite:FlxTextFormat = new FlxTextFormat(run.color, run.bold, run.italic, OUTLINE_COLOR);

      text.addFormat(formatGray, run.start, run.end);
      highlight.addFormat(formatWhite, run.start, run.end);
    }

    text.scale.set(lineScale, lineScale);
    highlight.scale.set(lineScale, lineScale);

    text.setPosition(MARGIN_LEFT, targetY + ENTER_SLIDE_Y);
    highlight.setPosition(MARGIN_LEFT, targetY + ENTER_SLIDE_Y);

    text.alpha = 0;
    highlight.alpha = 0;

    text.visible = true;
    highlight.visible = true;

    text.clipRect = null;
    highlight.clipRect = FlxRect.get(0, 0, 0, highlight.frameHeight);

    FlxTween.tween(text, {alpha: targetAlpha, y: targetY}, FADE_IN_TIME,
      {ease: FlxEase.quadOut});

    FlxTween.tween(highlight, {alpha: targetAlpha, y: targetY}, FADE_IN_TIME,
      {ease: FlxEase.quadOut});
  }

  function promoteToTop(text:FlxText):Void
  {
    if (text == null) return;

    cancelTweens(text);

    var topScale:Float = TOP_TEXT_SCALE * mobileScale();

    FlxTween.tween(text, {y: slotY(true), alpha: 1}, PROMOTE_TIME,
      {ease: FlxEase.quadOut});

    FlxTween.tween(text.scale, {x: topScale, y: topScale}, PROMOTE_TIME,
      {ease: FlxEase.quadOut});
  }

  function fadeOut(text:FlxText):Void
  {
    if (text == null) return;

    var highlight:FlxText = getHighlight(text);

    fadeOutSingle(text);
    if (highlight != null)
      fadeOutSingle(highlight);
  }

  function fadeOutSingle(text:FlxText):Void
  {
    cancelTweens(text);

    FlxTween.tween(text, {alpha: 0}, FADE_OUT_TIME,
      {
        ease: FlxEase.quadOut,
        onComplete: function(_):Void {
          text.visible = false;
          text.clipRect = null;
        }
      });
  }

  function acquireText():FlxText
  {
    var fallback:FlxText = null;

    for (text in pool)
    {
      if (text == topText || text == bottomText) continue;
      if (!text.visible) return text;
      fallback = text;
    }

    cancelTweens(fallback);
    return fallback;
  }

  function getHighlight(text:FlxText):FlxText
  {
    var idx:Int = pool.indexOf(text);

    if (idx < 0 || idx >= highlightPool.length)
      return null;

    return highlightPool[idx];
  }

  function cancelTweens(text:FlxText):Void
  {
    if (text == null) return;

    FlxTween.cancelTweensOf(text);
    FlxTween.cancelTweensOf(text.scale);
  }

  function slotY(isTop:Bool):Float
  {
    var offsetY:Float = isTop ? 0 : LINE_DISTANCE;
    return FlxG.height - MARGIN_BOTTOM + mobileOffsetY() + offsetY * mobileScale();
  }

  function mobileScale():Float
  {
    return FlxG.onMobile ? MOBILE_SCALE : 1;
  }

  function mobileOffsetY():Float
  {
    return FlxG.onMobile ? -360 : 0;
  }

  function canPreview(idx:Int, time:Float):Bool
  {
    var startsPhrase:Bool = idx == 0 || entries[idx].start - entries[idx - 1].end > PHRASE_GAP_MS;

    return entries[idx].start - time <= (startsPhrase ? PHRASE_START_LEAD_MS : NEXT_LINE_LEAD_MS);
  }

  function updateHighlight(text:FlxText, songPosition:Float):Void
  {
    if (text == null || !text.visible) return;

    var highlight:FlxText = getHighlight(text);
    if (highlight == null || !highlight.visible) return;

    var entry:Dynamic = findEntryForText(text);
    if (entry == null)
    {
      highlight.clipRect = null;
      return;
    }

    var elapsed:Float = songPosition - entry.start;

    if (elapsed <= 0)
    {
      highlight.clipRect = FlxRect.get(0, 0, 0, highlight.frameHeight);
      return;
    }

    var segments:Array<Dynamic> = entry.segments;

    if (segments == null || segments.length == 0)
    {
      highlight.clipRect = FlxRect.get(0, 0, highlight.frameWidth, highlight.frameHeight);
      return;
    }

    var cumulative:Float = 0;
    var revealIndex:Float = 0;

    for (segment in segments)
    {
      var duration:Float = segment.duration;

      if (duration <= 0)
      {
        revealIndex = segment.end;
        continue;
      }

      if (elapsed >= cumulative + duration)
      {
        cumulative += duration;
        revealIndex = segment.end;
        continue;
      }

      var progress:Float = (elapsed - cumulative) / duration;
      if (progress < 0) progress = 0;
      if (progress > 1) progress = 1;

      revealIndex = segment.start + (segment.end - segment.start) * progress;
      break;
    }

    var totalChars:Int = entry.text.length;
    var ratio:Float = (totalChars <= 0) ? 1 : revealIndex / totalChars;

    if (ratio < 0) ratio = 0;
    if (ratio > 1) ratio = 1;

    var clipWidth:Float = highlight.frameWidth * ratio;
    highlight.clipRect = FlxRect.get(
      0,
      0,
      clipWidth,
      highlight.frameHeight
    );
  }

  function findEntryForText(text:FlxText):Dynamic
  {
    if (text == topText && shownCur >= 0 && shownCur < entries.length)
      return entries[shownCur];

    if (text == bottomText && shownNext >= 0 && shownNext < entries.length)
      return entries[shownNext];

    return null;
  }

  function loadEntries(songId:String, suffix:String):Array<Dynamic>
  {
    var path:String = Paths.srt(LYRICS_FILE_KEY + suffix, null, 'data/songs/' + songId + '/subtitles/');
    if (!Assets.exists(path)) return [];

    return parseSRT(Assets.getText(path));
  }

  function parseSRT(raw:String):Array<Dynamic>
  {
    var normalized:String = StringTools.replace(StringTools.replace(raw, '\r\n', '\n'), '\r', '\n');

    if (normalized.length > 0 && normalized.charCodeAt(0) == 0xFEFF)
      normalized = normalized.substr(1);

    var parsed:Array<Dynamic> = [];

    for (cue in normalized.split('\n\n'))
    {
      var lines:Array<String> = StringTools.trim(cue).split('\n');
      if (lines.length < 2) continue;

      var timeIdx:Int = (lines[0].indexOf('-->') != -1) ? 0 : 1;
      if (timeIdx >= lines.length) continue;

      var range:Array<String> = lines[timeIdx].split('-->');
      if (range.length != 2) continue;

      var start:Float = parseTimecode(range[0]);
      var end:Float = parseTimecode(range[1]);

      if (start < 0 || end < 0) continue;

      var content:String = '';

      for (i in (timeIdx + 1)...lines.length)
      {
        var part:String = StringTools.trim(lines[i]);
        if (part.length > 0)
          content += (content.length > 0 ? ' ' : '') + part;
      }

      var timed:Dynamic = parseTimedContent(content);
      if (timed.text.length == 0) continue;

      parsed.push({
        start: start,
        end: end,
        text: timed.text,
        runs: timed.runs,
        font: timed.font,
        segments: timed.segments
      });
    }

    parsed.sort((c, d) -> Std.int(c.start - d.start));
    return parsed;
  }

  function parseTimedContent(source:String):Dynamic
  {
    var token:EReg = new EReg("([0-9]+(?:\\.[0-9]+)?:)|\\[w:([0-9]+(?:\\.[0-9]+)?)\\]", "g");

    var plain:String = "";
    var runs:Array<Dynamic> = [];
    var segments:Array<Dynamic> = [];
    var font:String = null;

    var searchPos:Int = 0;
    var lastPos:Int = 0;
    var currentDuration:Float = 0;
    var hasTiming:Bool = false;

    var richBuffer:String = "";
    var segmentStart:Int = 0;

    while (searchPos < source.length && token.matchSub(source, searchPos))
    {
      var pos:Dynamic = token.matchedPos();
      var durationToken:String = token.matched(1);
      var waitToken:String = token.matched(2);

      var before:String = source.substring(lastPos, pos.pos);
      richBuffer += before;

      if (waitToken != null)
      {
        if (richBuffer.length > 0)
        {
          var rich:Dynamic = parseRichText(richBuffer);
          var start:Int = plain.length;

          plain += rich.text;
          for (run in rich.runs)
          {
            runs.push({
              start: run.start + start,
              end: run.end + start,
              color: run.color,
              bold: run.bold,
              italic: run.italic
            });
          }

          if (font == null) font = rich.font;

          segments.push({
            start: segmentStart,
            end: plain.length,
            duration: currentDuration,
            wait: false
          });

          segmentStart = plain.length;
          richBuffer = "";
          currentDuration = 0;
        }

        segments.push({
          start: plain.length,
          end: plain.length,
          duration: Std.parseFloat(waitToken) * 1000,
          wait: true
        });
      }
      else
      {
        if (hasTiming || richBuffer.length > 0)
        {
          var rich:Dynamic = parseRichText(richBuffer);
          var start:Int = plain.length;

          plain += rich.text;
          for (run in rich.runs)
          {
            runs.push({
              start: run.start + start,
              end: run.end + start,
              color: run.color,
              bold: run.bold,
              italic: run.italic
            });
          }

          if (font == null) font = rich.font;

          segments.push({
            start: segmentStart,
            end: plain.length,
            duration: currentDuration,
            wait: false
          });

          segmentStart = plain.length;
          richBuffer = "";
        }

        currentDuration =
          Std.parseFloat(durationToken.substr(0, durationToken.length - 1)) * 1000;
        hasTiming = true;
      }

      lastPos = pos.pos + pos.len;
      searchPos = lastPos;
    }

    richBuffer += source.substr(lastPos);

    if (richBuffer.length > 0)
    {
      var rich:Dynamic = parseRichText(richBuffer);
      var start:Int = plain.length;

      plain += rich.text;
      for (run in rich.runs)
      {
        runs.push({
          start: run.start + start,
          end: run.end + start,
          color: run.color,
          bold: run.bold,
          italic: run.italic
        });
      }

      if (font == null) font = rich.font;

      segments.push({
        start: segmentStart,
        end: plain.length,
        duration: currentDuration,
        wait: false
      });
    }

    if (!hasTiming && segments.length == 0)
    {
      var rich:Dynamic = parseRichText(source);
      return {
        text: rich.text,
        runs: rich.runs,
        font: rich.font,
        segments: [{
          start: 0,
          end: rich.text.length,
          duration: 0,
          wait: false
        }]
      };
    }

    return {
      text: plain,
      runs: runs,
      font: font,
      segments: segments
    };
  }

  function parseRichText(source:String):Dynamic
  {
    var plain:String = '';
    var runs:Array<Dynamic> = [];
    var stack:Array<Dynamic> = [];
    var style:Dynamic = {color: null, bold: false, italic: false};
    var face:String = null;
    var runStart:Int = 0;
    var i:Int = 0;

    while (i < source.length)
    {
      var ch:String = source.charAt(i);

      var tagEnd:Int = (ch == '<' && source.charAt(i + 1) != ' ') ? source.indexOf('>', i) : -1;
      if (tagEnd != -1)
      {
        var tagBody:String = StringTools.trim(source.substring(i + 1, tagEnd));
        var isClosing:Bool = tagBody.charAt(0) == '/';
        var tagName:String = (isClosing ? StringTools.trim(tagBody.substr(1)) : tagBody).split(' ')[0].toLowerCase();

        if (FORMAT_TAGS.indexOf(tagName) != -1)
        {
          pushRun(runs, style, runStart, plain.length);
          runStart = plain.length;

          if (!isClosing)
          {
            stack.push(style);
            style =
              {
                color: style.color,
                bold: style.bold || tagName == 'b' || tagName == 'strong',
                italic: style.italic || tagName == 'i' || tagName == 'em'};

            if (tagName == 'font')
            {
              var color:Dynamic = parseColor(getTagAttribute(tagBody, 'color'));
              if (color != null) style.color = color;
              if (face == null) face = resolveFont(getTagAttribute(tagBody, 'face'));
            }
          }
          else if (stack.length > 0)
          {
            style = stack.pop();
          }

          i = tagEnd + 1;
          continue;
        }
      }

      plain += ch;
      i++;
    }

    pushRun(runs, style, runStart, plain.length);

    return {text: plain, runs: runs, font: face};
  }

  function pushRun(runs:Array<Dynamic>, style:Dynamic, start:Int, end:Int):Void
  {
    if (end > start && (style.color != null || style.bold || style.italic))
    {
      runs.push(
        {
          start: start,
          end: end,
          color: style.color,
          bold: style.bold,
          italic: style.italic
        });
    }
  }

  function getTagAttribute(tagBody:String, name:String):String
  {
    var idx:Int = tagBody.toLowerCase().indexOf(' ' + name + '=');
    if (idx == -1) return null;

    var start:Int = idx + name.length + 2;
    var quote:String = tagBody.charAt(start);
    var isQuoted:Bool = quote == '"' || quote == '\'';
    if (isQuoted) start++;

    var end:Int = tagBody.indexOf(isQuoted ? quote : ' ', start);
    return (end == -1) ? tagBody.substr(start) : tagBody.substring(start, end);
  }

  function parseColor(raw:String):Dynamic
  {
    if (raw == null) return null;

    var value:String = StringTools.trim(raw);
    if (value.length == 4 && value.charAt(0) == '#')
    {
      value = '#' + value.charAt(1) + value.charAt(1) + value.charAt(2) + value.charAt(2) + value.charAt(3) + value.charAt(3);
    }

    return FlxColor.fromString(value);
  }

  function resolveFont(face:String):String
  {
    var fileName:String = (face == null) ? '' : StringTools.trim(face);
    if (fileName.length == 0) return null;
    if (fileName.indexOf('.') == -1) fileName += '.ttf';

    var path:String = Paths.font(fileName);
    return Assets.exists(path) ? path : null;
  }

  function parseTimecode(raw:String):Float
  {
    var parts:Array<String> = StringTools.replace(StringTools.trim(raw), ',', '.').split(':');
    if (parts.length != 3) return -1;

    var hours:Null<Int> = Std.parseInt(parts[0]);
    var minutes:Null<Int> = Std.parseInt(parts[1]);
    var seconds:Float = Std.parseFloat(parts[2]);
    if (hours == null || minutes == null || Math.isNaN(seconds)) return -1;

    return Math.round((hours * 3600 + minutes * 60 + seconds) * 1000);
  }
}